# ── Supabase (Cloud Sync — RECOMENDADO) ──────────────────────────────────────
# Supabase tem prioridade sobre Firebase quando configurado.
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
#
# Como configurar (5 minutos):
#   1. Acesse https://supabase.com → New Project (plano gratuito)
#   2. Vá em Settings → API:
#      - "Project URL"         → VITE_SUPABASE_URL
#      - "anon / public" key   → VITE_SUPABASE_ANON_KEY
#   3. Vá em SQL Editor → cole e execute o conteúdo de supabase-schema.sql
#   4. Vá em Authentication → Providers → Google → habilite e configure
#      (Client ID e Secret do Google Cloud Console OAuth 2.0)
#   5. Authentication → URL Configuration → adicione em "Redirect URLs":
#      https://kraken-dashboard-peach.vercel.app
#   6. Em Vercel: Settings → Environment Variables → adicione as duas vars abaixo

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Firebase (Cloud Sync — legado) ────────────────────────────────────────────
# Mantido para compatibilidade. Se SUPABASE estiver configurado, Firebase é ignorado.
#
# Como obter:
#   1. Go to https://console.firebase.google.com
#   2. Create a project (or use an existing one)
#   3. Add a Web app → copy the firebaseConfig object
#   4. Enable Authentication → Sign-in method → Google
#   5. Enable Firestore Database (start in production mode)
#   6. Deploy firestore.rules (firebase deploy --only firestore:rules)
#   7. In Vercel project settings → Environment Variables → add each var below
#   8. Add your domain to Firebase Auth → Authorized Domains:
#      kraken-dashboard-peach.vercel.app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional (not required for Auth + Firestore):
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ── Anthropic (AI Analysis) ───────────────────────────────────────────────────
# Set in Vercel project settings → Environment Variables (server-side only)
# ANTHROPIC_API_KEY=
